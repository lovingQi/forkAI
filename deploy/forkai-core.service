[Unit]
Description=forkAI core (FastAPI unified backend)
After=network.target forkai-llm.service
Wants=forkai-llm.service

[Service]
Type=simple
WorkingDirectory=/usr/local/forkai/services/core
Environment=JARVIS_BASE_URL=http://127.0.0.1:8080
Environment=FORKAI_PORT=19000
Environment=VEHICLE_ID=fork-01
Environment=FORKAI_TTS_API_KEY=
ExecStart=/usr/local/forkai/services/core/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 19000
Restart=always
RestartSec=2
MemoryMax=4G

[Install]
WantedBy=multi-user.target
