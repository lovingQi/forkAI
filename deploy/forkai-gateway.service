[Unit]
Description=forkAI voice gateway
After=network.target forkai-speech.service
Wants=forkai-speech.service

[Service]
Type=simple
WorkingDirectory=/opt/forkai
ExecStart=/usr/bin/npm run start -w @forkai/voice-gateway
Restart=on-failure
Environment=JARVIS_BASE_URL=http://127.0.0.1:8080
Environment=SPEECH_BASE_URL=http://127.0.0.1:19001
Environment=FORKAI_PORT=19000
Environment=VEHICLE_ID=fork-01

[Install]
WantedBy=multi-user.target
